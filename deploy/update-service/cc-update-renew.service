[Unit]
Description=Renew the registered CC pilot update index
Wants=network-online.target
After=network-online.target cc-update-service.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.cc-update-admin
ExecStart=/opt/cc-update-runtime/bin/node /opt/cc-update-renewer/scripts/renew-managed-index.mjs --config /root/.cc-update-admin/automation/config.json
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.cc-update-admin
